{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":dependencyDashboard",
		"helpers:pinGitHubActionDigestsToSemver",
		":maintainLockFilesWeekly",
		":semanticCommits"
	],
	"forkProcessing": "enabled",
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"schedule": ["before 6am on monday"],
	"prConcurrentLimit": 5,
	"minimumReleaseAge": "3 days",
	"osvVulnerabilityAlerts": true,
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"],
		"schedule": ["at any time"],
		"minimumReleaseAge": null
	},
	"packageRules": [
		{
			"description": "All minor and patch updates (Rust crates and GitHub Actions) in one weekly PR. Not automerged because it contains crates that ship in the app; fix(deps) so release-please cuts a patch release. Major updates keep their own PR.",
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "non-major dependencies",
			"automerge": false,
			"semanticCommitType": "fix",
			"semanticCommitScope": "deps"
		}
	]
}
