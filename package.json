{
	"name": "remote-volume",
	"version": "1.2.0",
	"description": "An application for controlling the system volume over a WebSocket connection",
	"main": "main.js",
	"type": "module",
	"displayName": "Remote Volume",
	"keywords": [],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "electron .",
		"test": "node --test",
		"build": "electron-builder --publish never",
		"build:win": "electron-builder --win --publish never"
	},
	"build": {
		"appId": "com.utsgmbh.volumeremote",
		"productName": "Remote Volume",
		"publish": null,
		"files": [
			"main.js",
			"volumeController.js",
			"preload.cjs",
			"settings.js",
			"index.html",
			"lib/**",
			"impl/**",
			"icon.ico",
			"icon.png",
			"menuicon.png"
		],
		"asarUnpack": [
			"impl/windows/*.exe"
		],
		"electronFuses": {
			"runAsNode": false,
			"enableCookieEncryption": true,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false,
			"enableEmbeddedAsarIntegrityValidation": true,
			"onlyLoadAppFromAsar": true
		},
		"mac": {
			"notarize": false,
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"icon": "icon.png"
		},
		"afterSign": "scripts/notarize.js",
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "icon.png"
		},
		"linux": {
			"target": [
				{
					"target": "deb",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "icon.png",
			"category": "AudioVideo"
		}
	},
	"author": "Ultimate Technology Solutions GmbH <info@ultimate-technology.de>",
	"license": "MIT",
	"dependencies": {
		"@capaj/naudiodon": "^2.4.0",
		"electron-auto-launch": "^5.0.7",
		"electron-log": "^5.4.4",
		"electron-store": "^12.0.0",
		"ws": "^8.22.1"
	},
	"devDependencies": {
		"@electron/notarize": "^3.1.2",
		"electron": "^45.2.2",
		"electron-builder": "^26.18.0"
	}
}
